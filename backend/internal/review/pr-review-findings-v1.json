{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Platform PR Review Findings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseSha", "headSha", "findings"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0"] },
    "baseSha": { "type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$" },
    "headSha": { "type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$" },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "severity", "confidence", "path", "startLine", "endLine"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 256 },
          "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "startLine": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "endLine": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
        }
      }
    }
  }
}
